{
  "manifest_version": 3,
  "name": "Recall — A little rediscovery",
  "version": "1.0.0",
  "description": "A calmer new tab. Rediscover the Chrome bookmarks you saved, privately and at your own pace.",
  "permissions": ["bookmarks", "storage", "search"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "120"
}
